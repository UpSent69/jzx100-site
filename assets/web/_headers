# Заголовки для Cloudflare Pages. Файл кладётся в /assets/web, потому что это
# publicDir - его содержимое попадает в корень сборки как есть.

# Файлы сборки Vite: в имени у каждого стоит хеш содержимого, поэтому при
# изменении меняется и имя. Такие можно кешировать навсегда.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Музыка: шестнадцать файлов по два мегабайта, имена постоянные. Неделя -
# компромисс между «не качать каждый раз» и «увидеть замену плейлиста».
/music/*
  Cache-Control: public, max-age=604800

/*
  # Браузер не должен угадывать тип файла по содержимому: только то,
  # что сказано в Content-Type.
  X-Content-Type-Options: nosniff
  # На чужие сайты уходит только домен, без пути
  Referrer-Policy: strict-origin-when-cross-origin
  # Сайту не нужны ни камера, ни микрофон, ни геопозиция
  Permissions-Policy: camera=(), microphone=(), geolocation=()
