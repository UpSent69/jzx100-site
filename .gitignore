# Зависимости и сборка — восстанавливаются из package-lock.json и исходников
node_modules/
dist/

# Снимки и отчёты инструментов из tools/: они делаются заново одной командой
shots/
*.log

# Временные файлы, которыми пользуются инструменты во время работы
tools/_*.mjs

# Системное
.DS_Store
Thumbs.db
desktop.ini

# Материалы заказчика лежат в репозитории намеренно — и оригиналы в /assets,
# и облегчённые версии в /assets/web. Оригиналы нужны, чтобы облегчённые версии
# можно было пересобрать другими настройками, а облегчённые — чтобы сайт
# запускался сразу после клона, без ffmpeg и Python. Вместе это 38 МБ:
# для репозитория с видео это нормально, и ни один файл не подходит близко
# к пределу GitHub.
