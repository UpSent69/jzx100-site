# Зависимости и сборка — восстанавливаются из package-lock.json и исходников
node_modules/
dist/

# Снимки и отчёты инструментов из tools/: они делаются заново одной командой
shots/
*.log

# Временные файлы, которыми пользуются инструменты во время работы
tools/_*.mjs

# Системное
.DS_Store
Thumbs.db
desktop.ini

# Материалы заказчика лежат в репозитории намеренно — и оригиналы в /assets,
# и облегчённые версии в /assets/web. Оригиналы нужны, чтобы облегчённые версии
# можно было пересобрать другими настройками, а облегчённые — чтобы сайт
# запускался сразу после клона, без ffmpeg и Python. Вместе это около 130 МБ:
# для репозитория с видео это нормально, и ни один файл не подходит близко
# к пределу GitHub — самый тяжёлый чуть больше одиннадцати мегабайт.

# Оригинал фона третьего пространства — 776 МБ: шесть минут в 2560 при 60
# кадрах. В репозиторий он не идёт, и дело не только во вкусе: у GitHub жёсткий
# предел в 100 МБ на файл, этот втрое больше. Лежит у заказчика в облаке,
# в вебе используется двадцатичетырёхсекундный кусок из /assets/web.
# Положить рядом — и tools/cult_assets.sh пересоберёт из него веб-копию.
assets/cult-bg.mp4
