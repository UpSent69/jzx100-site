{
  // Настройки публикации на Cloudflare.
  //
  // Сайт статический: ни серверного кода, ни базы. Поэтому здесь нет
  // точки входа - только каталог со сборкой. Cloudflare раздаёт его файлы
  // напрямую со своей сети, запросы к ним бесплатны и не ограничены.
  //
  // Каталог собирается командой npm run build, она же указана в настройках
  // проекта на стороне Cloudflare.
  "name": "jzx100-site",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./dist"
  }
}
